# Copy to .env and fill in what you need. Every variable is optional for local work.

# Set to production on the live site only, and leave it unset everywhere else. Production turns on the
# Strict-Transport-Security header, makes SITE_URL and DATABASE_URL required (a build or start refuses
# until they and the other variables in the README's "Hosting on Vercel" section are set), and refuses
# placeholder images in published galleries. Set it when `pnpm build` runs, not only when the site runs:
# the build bakes it in, so changing it needs a rebuild.
SITE_ENV=

# The site's public origin, such as https://example.com. Required when SITE_ENV is production; when it is
# unset, the site uses http://localhost:3000. Set it when `pnpm build` runs, not only when the site runs:
# the build bakes it in, so changing it needs a rebuild.
SITE_URL=

# MongoDB connection string. Leave unset to run a local database in .data/. The local database runs only
# when SITE_ENV is not production: with SITE_ENV=production, `pnpm dev`, `pnpm build` and `pnpm start` refuse
# without DATABASE_URL (or the MONGODB_URI that Vercel's MongoDB add-on sets).
DATABASE_URL=

# Signs logins. Leave unset locally: the app makes one in .data/. Set a long random value anywhere else.
PAYLOAD_SECRET=

# Resend API key. Leave unset to write every email to .outbox/ instead of sending it.
RESEND_API_KEY=

# Sender for outgoing email. Required when RESEND_API_KEY is set.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Cloudflare's always-pass Turnstile test site key, for local runs and Vercel Preview builds only, never
# Production. The live site needs a real key; it is parked for now, as the README's PARKED line says. It
# is read when `pnpm build` runs, so changing it needs a rebuild.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare's always-pass Turnstile test secret key, for local runs and Vercel Preview builds only, never
# Production. The live site needs a real key; it is parked for now, as the README's PARKED line says.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# The Calendly event link the booking forms open after a send that saved. Unset, or not an
# https://calendly.com/ link, the forms end with their send-and-reply message and show no time step.
# It is read when `pnpm build` runs, so changing it needs a rebuild.
NEXT_PUBLIC_CALENDLY_URL=
